# Окружение ORBITA на сервере агентства. Скопируйте в deploy/server/.env и заполните.
# .env в .gitignore: репозиторий публичный, ключей в нём нет (инвариант 12).
#
# Случайные значения генерируются на сервере, например:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

ORBITA_ENV=production
ORBITA_TIMEZONE=Asia/Tashkent

# Адрес, по которому сотрудники открывают ORBITA: на него ведут личные ссылки доступа.
ORBITA_BASE_URL=https://orbita.example.uz
# Что слушает Caddy: доменное имя — сертификат HTTPS получается сам; «:80» — без HTTPS,
# только для проверки сборки на localhost.
ORBITA_SITE_ADDRESS=orbita.example.uz

ORBITA_DB_USER=orbita
ORBITA_DB_NAME=orbita
ORBITA_DB_PASSWORD=

# Не короче 32 знаков: подписывает сессии.
ORBITA_SESSION_SECRET=
# Не короче 16 знаков: им cron вызывает задачи по расписанию.
ORBITA_JOBS_SECRET=

# Необязательно: закрытый ключ уведомлений (ADR-0026). Пусто — уведомления выключены.
ORBITA_VAPID_PRIVATE_KEY=
