# Скопировать в .env и заполнить. Файл .env в репозиторий не коммитится.
# Ключей в репозитории нет: рабочие значения живут в окружении площадок и в секретах
# GitHub (docs/SETUP.md).

# --- Приложение ---
ORBITA_ENV=development
# Адрес, по которому открывается интерфейс. Из него собираются личные ссылки доступа.
ORBITA_BASE_URL=http://localhost:5173
ORBITA_DEFAULT_LOCALE=ru
ORBITA_TIMEZONE=Asia/Tashkent
# Коммит выложенной сборки: подставляется при выкладке и возвращается в /api/health,
# чтобы проверка после выкладки видела не «что-то ответило», а «ответил этот коммит».
ORBITA_COMMIT=dev

# --- Секреты ---
# Подписывает cookie сессии и личные ссылки доступа. Не короче 32 символов.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
ORBITA_SESSION_SECRET=смените-этот-ключ-перед-развёртыванием-он-длинный-намеренно
# Пропуск к эндпоинту задач по расписанию /internal/jobs/{name}. Знает его только
# расписание (GitHub Actions) — ADR-0032, ADR-0035.
ORBITA_JOBS_SECRET=смените-и-этот-тоже

# --- База данных ---
# Одна строка подключения: так её отдают и Neon, и сервер агентства.
ORBITA_DATABASE_URL=postgresql+asyncpg://orbita:orbita@127.0.0.1:55432/orbita
# Тестовая база обязана отличаться от рабочей — иначе тесты затрут данные разработки;
# проверка стоит в conftest и останавливает прогон.
ORBITA_TEST_DATABASE_URL=postgresql+asyncpg://orbita:orbita@127.0.0.1:55432/orbita_test
ORBITA_DB_SCHEMA=orbita
# Именно 127.0.0.1, а не localhost: Windows резолвит localhost сначала в ::1, а контейнер
# слушает только IPv4 — подключение занимает 2 секунды вместо 70 миллисекунд.
# Измерено, а не предположено.
ORBITA_DB_PORT=55432
ORBITA_DB_NAME=orbita
ORBITA_DB_USER=orbita
ORBITA_DB_PASSWORD=orbita
ORBITA_TEST_DB=orbita_test

# --- Файлы (порт FileStorage) ---
# local — папка на диске для разработки, blob — Vercel Blob в облаке,
# s3 — S3-совместимое хранилище на сервере агентства, memory — только для тестов.
ORBITA_FILE_STORAGE=local
ORBITA_FILE_DIR=./data/files
ORBITA_MAX_UPLOAD_MB=50
# Сколько секунд живёт подписанная ссылка на файл.
ORBITA_DOWNLOAD_LINK_SECONDS=300
# Токен Vercel Blob — только при ORBITA_FILE_STORAGE=blob
ORBITA_BLOB_TOKEN=
# S3 — только при ORBITA_FILE_STORAGE=s3
ORBITA_S3_ENDPOINT=
ORBITA_S3_BUCKET=
ORBITA_S3_ACCESS_KEY=
ORBITA_S3_SECRET_KEY=

# --- Пуш-уведомления (порт PushSender) ---
# Веб-пуш по стандарту VAPID: на iPhone работает после установки на экран «Домой».
# Ключи: npx web-push generate-vapid-keys
ORBITA_VAPID_PUBLIC_KEY=
ORBITA_VAPID_PRIVATE_KEY=
ORBITA_VAPID_SUBJECT=mailto:orbita@uzspace.uz

# --- Связка с SETA (порт SetaGateway; в блоке 3 — без подключения) ---
ORBITA_SETA_API_URL=
ORBITA_SETA_API_TOKEN=

# --- Пороги сигналов ---
# Значения по умолчанию для первой установки. В рабочей системе они редактируются в
# справочнике и меняются без выкладки: пороги — данные, а не код.
ORBITA_WARN_DAYS=3
ORBITA_QUIET_DAYS=14
ORBITA_SUMMARY_AT=08:30
