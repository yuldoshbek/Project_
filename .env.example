# Скопировать в .env и заполнить. Файл .env в репозиторий не коммитится.

# --- Приложение ---
ORBITA_ENV=development
ORBITA_SECRET_KEY=change-me-in-production
ORBITA_BASE_URL=http://localhost:5173
ORBITA_DEFAULT_LOCALE=ru
ORBITA_TIMEZONE=Asia/Tashkent

# --- База данных (ADR-0001: отдельная схема orbita в общем с SETA кластере) ---
# ORBITA_TEST_DB обязана отличаться от ORBITA_DB_NAME — иначе тесты затрут данные
# разработки; проверка стоит в conftest и останавливает прогон.
ORBITA_DB_HOST=localhost
ORBITA_DB_PORT=55432
ORBITA_DB_NAME=orbita
ORBITA_DB_USER=orbita
ORBITA_DB_PASSWORD=orbita
ORBITA_DB_SCHEMA=orbita
ORBITA_TEST_DB=orbita_test

# --- Redis и фоновые задачи ---
ORBITA_REDIS_PORT=56379
ORBITA_REDIS_URL=redis://localhost:56379/0

# --- Хранилище файлов (ADR-0009) ---
ORBITA_S3_ENDPOINT=http://localhost:59000
ORBITA_S3_PORT=59000
ORBITA_S3_CONSOLE_PORT=59001
ORBITA_S3_BUCKET=orbita
ORBITA_S3_ACCESS_KEY=orbita
ORBITA_S3_SECRET_KEY=orbita-secret
ORBITA_MAX_UPLOAD_MB=50

# --- Провайдер личности (ADR-0001): local | seta ---
ORBITA_IDENTITY_PROVIDER=local
ORBITA_SETA_API_URL=
ORBITA_SETA_API_TOKEN=

# --- Каналы уведомлений (ADR-0008) ---
ORBITA_SMTP_HOST=localhost
ORBITA_SMTP_PORT=51025
ORBITA_MAIL_UI_PORT=58025
ORBITA_SMTP_USER=
ORBITA_SMTP_PASSWORD=
ORBITA_SMTP_FROM=orbita@uzspace.uz
ORBITA_TELEGRAM_ENABLED=false

# --- Пороги контроля сроков (ADR-0005, ADR-0008; значения по умолчанию,
#     в рабочей системе редактируются в справочнике настроек) ---
ORBITA_WARN_DAYS=3
ORBITA_WARN_RATIO=0.8
ORBITA_ESCALATION_DELAY_HOURS=24
ORBITA_ESCALATION_STEP_HOURS=24
ORBITA_QUIET_HOURS_START=20
ORBITA_QUIET_HOURS_END=8
