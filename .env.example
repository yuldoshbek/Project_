# Скопировать в .env и заполнить. Файл .env в репозиторий не коммитится.

# --- Приложение ---
ORBITA_ENV=development
# Не короче 32 символов — иначе приложение не стартует (RFC 7518, раздел 3.2).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
ORBITA_SECRET_KEY=смените-этот-ключ-перед-развёртыванием-он-длинный-намеренно
ORBITA_BASE_URL=http://localhost:5173
ORBITA_DEFAULT_LOCALE=ru
ORBITA_TIMEZONE=Asia/Tashkent

# --- База данных (ADR-0001: отдельная схема orbita в общем с SETA кластере) ---
# ORBITA_TEST_DB обязана отличаться от ORBITA_DB_NAME — иначе тесты затрут данные
# разработки; проверка стоит в conftest и останавливает прогон.
# Именно 127.0.0.1, а не localhost: Windows резолвит localhost сначала в ::1, а
# контейнеры слушают только IPv4 (docker-compose.yml) — подключение занимает 2 секунды
# вместо 70 миллисекунд. Измерено, а не предположено.
ORBITA_DB_HOST=127.0.0.1
ORBITA_DB_PORT=55432
ORBITA_DB_NAME=orbita
ORBITA_DB_USER=orbita
ORBITA_DB_PASSWORD=orbita
ORBITA_DB_SCHEMA=orbita
ORBITA_TEST_DB=orbita_test

# --- Redis и фоновые задачи ---
ORBITA_REDIS_PORT=56379
ORBITA_REDIS_URL=redis://127.0.0.1:56379/0

# --- Хранилище файлов (ADR-0009) ---
ORBITA_S3_ENDPOINT=http://127.0.0.1:59000
ORBITA_S3_PORT=59000
ORBITA_S3_CONSOLE_PORT=59001
ORBITA_S3_BUCKET=orbita
ORBITA_S3_ACCESS_KEY=orbita
ORBITA_S3_SECRET_KEY=orbita-secret
ORBITA_MAX_UPLOAD_MB=50
# Сколько секунд живёт подписанная ссылка на файл. Для проектов с грифом — отдельно и
# короче: такая ссылка не должна доживать до того, как её кто-то перешлёт (ADR-0007).
ORBITA_DOWNLOAD_LINK_SECONDS=300
ORBITA_RESTRICTED_LINK_SECONDS=60

# --- Антивирус (Q7) ---
# clamav — проверять, disabled — не проверять. Второе годится для разработки без
# поднятого окружения; на рабочем контуре оно означает, что требование СБ не выполняется.
ORBITA_ANTIVIRUS=clamav
ORBITA_ANTIVIRUS_HOST=127.0.0.1
ORBITA_ANTIVIRUS_PORT=53310

# --- Предпросмотр офисных форматов (ADR-0009) ---
ORBITA_PREVIEW_CONVERTER=gotenberg
ORBITA_PREVIEW_URL=http://127.0.0.1:53000
ORBITA_PREVIEW_PORT=53000

# --- Telegram-бот (ADR-0013). Токен только здесь: репозиторий публичный ---
ORBITA_TELEGRAM_BOT_TOKEN=
ORBITA_TELEGRAM_DIGEST_AT=08:30

# --- Google-календарь (ADR-0012). Секрет только здесь ---
# Синхронизация выключена по умолчанию и включается в настройках после подключения
# аккаунта; вопрос о допустимости выгрузки — к службе безопасности (Q15).
ORBITA_GOOGLE_CLIENT_ID=
ORBITA_GOOGLE_CLIENT_SECRET=
ORBITA_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/google/callback
# Ключ шифрования токенов обновления в базе. НЕ входит в резервную копию базы —
# иначе копия становится ключом доступа к календарю руководителя.
ORBITA_TOKEN_ENCRYPTION_KEY=
ORBITA_GOOGLE_SYNC_INTERVAL_MINUTES=10

# --- Провайдер личности (ADR-0001): local | seta ---
ORBITA_IDENTITY_PROVIDER=local
ORBITA_SETA_API_URL=
ORBITA_SETA_API_TOKEN=

# --- Каналы уведомлений (ADR-0008) ---
ORBITA_SMTP_HOST=127.0.0.1
ORBITA_SMTP_PORT=51025
ORBITA_MAIL_UI_PORT=58025
ORBITA_SMTP_USER=
ORBITA_SMTP_PASSWORD=
ORBITA_SMTP_FROM=orbita@uzspace.uz

# --- Пороги контроля сроков (ADR-0005; значения по умолчанию,
#     в рабочей системе редактируются в справочнике настроек) ---
ORBITA_WARN_DAYS=3
ORBITA_WARN_RATIO=0.8
ORBITA_QUIET_HOURS_START=20
ORBITA_QUIET_HOURS_END=8
