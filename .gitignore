# Окружение и секреты
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*

# Данные: реальные сведения агентства в репозиторий не попадают.
# Репозиторий публичный, а в контрольных таблицах «Ижро» — поручения Администрации
# Президента с фамилиями ответственных. Настоящие файлы кладутся в data/ и остаются
# только на машине разработчика; в git едет один README, объясняющий, что туда класть.
*.dump
*.sql.gz
*.docx
*.xlsx
backups/
uploads/
# data/* , а не data/ : в игнорируемую папку git не заходит вовсе,
# и исключение !data/README.md после data/ не сработало бы.
data/*
!data/README.md

# Локальные артефакты площадок: в .vercel и .netlify лежат идентификаторы проекта и кеш
# сборки этой машины. На площадке они свои, в репозитории им места нет.
.vercel/
.netlify/

# Отчёты Playwright: снимки экранов прикладываются к отчёту блока, а не коммитятся пачкой
playwright-report/
test-results/

# Среда разработки
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Локальные настройки Claude Code
.claude/settings.local.json

# Собранный холст дизайн-системы: 2,6 МБ редактора вокруг наших листов.
# Источник — design/*.dc.html и design/canvas.json, холст пересобирается из них.
design/orbita-design-system.html
